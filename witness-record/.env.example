# ---------------------------------------------------------------------------
# THE WITNESS RECORD — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# See docs/SETUP.md for the full configuration guide.
# ---------------------------------------------------------------------------

# Public origin of the deployed site (no trailing slash). Used for OAuth
# redirect URIs, CSRF origin checks, the private submission link and QR code.
BASE_URL=https://witness.example.org

# Server port (production deployments usually sit behind a TLS proxy).
PORT=8080
NODE_ENV=production

# PostgreSQL connection string (TLS strongly recommended in production).
DATABASE_URL=postgres://witness:CHANGE_ME@db.example.org:5432/witness_record
# Set to "require" to force TLS to the database.
DATABASE_SSL=require
# PEM of the database CA when the server certificate is not publicly trusted (Supabase: Settings → Database → SSL → Download certificate).
# Paste the certificate with literal \n line breaks, or leave empty.
DATABASE_SSL_CA=

# 32+ random bytes, hex or base64. Signs session cookies, OAuth state cookies and
# short-lived download links. Rotate with care (active sessions are invalidated).
SESSION_SECRET=
# 32 random bytes, hex. Encrypts admin TOTP secrets at rest (app-level).
APP_ENCRYPTION_KEY=

# --- Sign in with Google (OpenID Connect) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Microsoft (Microsoft Entra ID / personal accounts) -------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = work/school + personal (Outlook.com, Hotmail). "consumers" =
# personal only. "organizations" = work/school only. Or a specific tenant ID.
MICROSOFT_TENANT=common

# --- Admin (case owner) allowlist -------------------------------------------
# Comma-separated entries. Strongest form binds provider + stable subject id:
#   google:sub:1234567890,microsoft:sub:00000000-0000-0000-0000-000000000000
# Email form is accepted only for provider-verified emails:
#   google:email:owner@example.org
ADMIN_ALLOWLIST=
# Require TOTP multi-factor for admin dashboard access (recommended: true).
ADMIN_MFA_REQUIRED=true
# Require witnesses to arrive through a private invite link created in the dashboard.
REQUIRE_INVITE_LINK=true

# --- Private object storage --------------------------------------------------
# STORAGE_DRIVER=s3 (production) | local (development / single-server only)
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
# Optional: for Cloudflare R2, Backblaze B2, MinIO etc.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Server-side encryption header for uploads: AES256 or aws:kms
S3_SSE=AES256
# Local driver only: directory for files (must be on an encrypted volume).
LOCAL_STORAGE_DIR=./data/storage

# --- Malware screening (optional, ClamAV daemon) ----------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Limits ------------------------------------------------------------------
MAX_VIDEO_BYTES=1073741824
MAX_DOCUMENT_BYTES=26214400
MAX_DOCUMENTS_PER_STATEMENT=10
UPLOAD_CHUNK_BYTES=5242880

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
ADMIN_SESSION_IDLE_MINUTES=20
DOWNLOAD_LINK_TTL_SECONDS=300

# --- Retention ---------------------------------------------------------------
# Draft (never signed) statements are purged after this many days.
DRAFT_RETENTION_DAYS=90
# Run the daily in-process purge of expired drafts (or run scripts/purge-drafts.ts from cron instead).
RETENTION_JOB_ENABLED=true
# Finalized statements are retained until this date at minimum (legal hold);
# leave empty for indefinite retention. Finalized records are never auto-purged.
LEGAL_HOLD_UNTIL=
# Date (YYYY-MM-DD) you last restored a backup successfully; shown on the readiness checklist.
BACKUP_LAST_VERIFIED=

# --- Case metadata -------------------------------------------------------------
CASE_SUBJECT_NAME=Edwin "Eddie" Colón
CASE_ADDRESS=1665 Morris Avenue, Bronx, New York
CASE_OWNER_CONTACT_EMAIL=

# --- Technical metadata collection (disclosed to witnesses) --------------------
# Collect client IP address and user agent on sessions, uploads and signatures.
COLLECT_IP_ADDRESS=true
COLLECT_USER_AGENT=true
# Set when behind a trusted reverse proxy so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
