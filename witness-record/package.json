{
  "name": "the-witness-record",
  "version": "1.0.0",
  "private": true,
  "description": "THE WITNESS RECORD — private witness-affirmation platform for residence documentation (1665 Morris Avenue).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "migrate": "tsx server/src/db/migrate.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "readiness": "tsx scripts/readiness.ts",
    "check:oidc": "tsx scripts/check-oidc.ts",
    "export:records": "tsx scripts/export-records.ts",
    "backup:db": "bash scripts/backup-db.sh",
    "admin:reset-mfa": "tsx scripts/reset-admin-mfa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "archiver": "8.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "file-type": "22.3.0",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/archiver": "8.0.0",
    "@types/node": "22.19.19",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.10",
    "jose": "6.2.14",
    "oauth2-mock-server": "9.3.0",
    "pdf-parse": "2.4.5",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
